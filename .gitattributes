# Use LF for all text files
* text=auto eol=lf

# Explicitly keep common source/config files as LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.dockerfile text eol=lf

# Windows-specific scripts, if you have any
*.bat text eol=crlf
*.cmd text eol=crlf

# Never modify binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary